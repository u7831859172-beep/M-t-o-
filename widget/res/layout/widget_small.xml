<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:gravity="center" android:padding="10dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@mipmap/ic_launcher" android:scaleType="fitCenter" android:layout_marginEnd="5dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Atmoz" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:alpha="0.9"/>
    </LinearLayout>
    <TextView android:id="@+id/city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="#9FD0FF" android:singleLine="true" android:ellipsize="end" android:textStyle="bold"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <ImageView android:id="@+id/icon" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="6dp" android:scaleType="fitCenter"/>
        <TextView android:id="@+id/temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="32sp" android:textColor="#FFFFFF" android:singleLine="true" android:fontFamily="sans-serif-light"/>
    </LinearLayout>
    <TextView android:id="@+id/range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="#BCD3F5" android:singleLine="true"/>
</LinearLayout>
